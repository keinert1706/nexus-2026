# Copia estas variables en Netlify → Site configuration → Environment variables.
# Nunca subas un archivo .env real con valores reales a GitHub.

# Panel de Neon → tu proyecto → Connect → cadena de conexión (Connection string)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@TU-HOST.neon.tech/neondb?sslmode=require

# La contraseña para entrar al dashboard de registros (elige la tuya)
DASHBOARD_PASSWORD=Nexus-Diamante-2026
